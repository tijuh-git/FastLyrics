<?xml version="1.0" encoding="utf-8"?>
<!-- Controls bar: ≡ pass-through  ↑↑ expand-to-app  ⚙ settings  ✕ close-service -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_lyrics_background"
        android:orientation="horizontal"
        android:padding="2dp">

        <!-- ≡ Pass-through toggle -->
        <ImageButton
            android:id="@+id/overlay_ctrl_touch_toggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/overlay_touch_through_off"
            android:padding="7dp"
            android:src="@drawable/baseline_drag_handle_24"
            android:tint="@android:color/white" />

        <!-- ↑↑ Expand to full app (double chevrons up = maximiser) -->
        <ImageButton
            android:id="@+id/overlay_ctrl_open_app"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Restore full app"
            android:padding="7dp"
            android:src="@drawable/ic_expand_up"
            android:tint="@android:color/white" />

        <!-- ⚙ Settings -->
        <ImageButton
            android:id="@+id/overlay_ctrl_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="7dp"
            android:src="@drawable/outline_settings_24"
            android:tint="@android:color/white" />

        <!-- ✕ Close overlay service (stays on current foreground app) -->
        <ImageButton
            android:id="@+id/overlay_ctrl_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/overlay_stop"
            android:padding="7dp"
            android:src="@drawable/baseline_close_24"
            android:tint="@android:color/white" />

    </LinearLayout>
</HorizontalScrollView>




