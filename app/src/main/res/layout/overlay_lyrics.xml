<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_lyrics_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Synced LyricViewX (used when LRC available) -->
    <com.dirror.lyricviewx.LyricViewX
        android:id="@+id/overlay_lyric_view_x"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone"
        app:lrcPadding="8dp" />

    <!-- Static lyrics (fallback) -->
    <TextView
        android:id="@+id/overlay_text_lyrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:maxLines="12"
        android:text="..."
        android:textColor="@android:color/white"
        android:textSize="18sp" />

</LinearLayout>

